rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function validExportUpload() {
      return request.resource != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType == 'application/zip';
    }

    match /users/{uid}/gratitude/{entryId}/{imageId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validImageUpload();
      allow delete: if owner(uid);
    }

    match /users/{uid}/books/{bookId}/{imageId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validImageUpload();
      allow delete: if owner(uid);
    }

    match /users/{uid}/wishlist/{itemId}/{imageId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validImageUpload();
      allow delete: if owner(uid);
    }

    match /users/{uid}/receipts/{transactionId}/{imageId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validImageUpload();
      allow delete: if owner(uid);
    }

    match /users/{uid}/exports/{exportId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validExportUpload();
      allow delete: if owner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
