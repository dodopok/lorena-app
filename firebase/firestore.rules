rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function validAuditFields() {
      return request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 1
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoUrl', 'locale', 'timeZone', 'currency',
          'createdAt', 'updatedAt', 'schemaVersion'
        ])
        && validAuditFields();
      allow update: if owner(uid)
        && changedOnly([
          'displayName', 'email', 'photoUrl', 'locale', 'timeZone', 'currency',
          'updatedAt', 'schemaVersion'
        ])
        && validAuditFields();
      allow delete: if owner(uid);

      match /settings/{document} {
        allow read: if owner(uid);
        allow write: if owner(uid)
          && document == 'preferences'
          && request.resource.data.keys().hasOnly([
            'waterGoalMl', 'quickWaterAmountsMl', 'allowanceAmountMinor',
            'allowanceDayOfMonth', 'allowanceRolloverMode',
            'biometricLockEnabled', 'notificationPreferences',
            'calendarPreferences', 'createdAt', 'updatedAt', 'schemaVersion'
          ])
          && request.resource.data.waterGoalMl is int
          && request.resource.data.waterGoalMl > 0
          && request.resource.data.allowanceAmountMinor is int
          && request.resource.data.allowanceAmountMinor >= 0
          && request.resource.data.allowanceDayOfMonth is int
          && request.resource.data.allowanceDayOfMonth >= 1
          && request.resource.data.allowanceDayOfMonth <= 31
          && validAuditFields();
      }

      match /water_logs/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly([
            'amountMl', 'occurredAt', 'localDate', 'source', 'createdAt',
            'updatedAt', 'schemaVersion'
          ])
          && request.resource.data.amountMl is int
          && request.resource.data.amountMl > 0
          && validAuditFields();
        allow delete: if owner(uid);
      }

      match /bowel_logs/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly([
            'occurredAt', 'localDate', 'bristolType', 'comfort', 'note',
            'createdAt', 'updatedAt', 'schemaVersion'
          ])
          && (!('bristolType' in request.resource.data)
              || (request.resource.data.bristolType is int
                  && request.resource.data.bristolType >= 1
                  && request.resource.data.bristolType <= 7))
          && validAuditFields();
        allow delete: if owner(uid);
      }

      match /exercise_sessions/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly([
            'activityType', 'customActivityName', 'startedAt', 'localDate',
            'durationMinutes', 'intensity', 'note', 'createdAt', 'updatedAt',
            'schemaVersion'
          ])
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes > 0
          && validAuditFields();
        allow delete: if owner(uid);
      }

      match /allowance_periods/{period} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.period == period
          && request.resource.data.allowanceAmountMinor is int
          && request.resource.data.allowanceAmountMinor >= 0
          && request.resource.data.rolloverMinor is int
          && request.resource.data.rolloverMinor >= 0
          && validAuditFields();
        allow delete: if owner(uid);
      }

      match /transactions/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.amountMinor is int
          && request.resource.data.amountMinor > 0
          && request.resource.data.period is string
          && request.resource.data.currency == 'BRL'
          && validAuditFields();
        allow delete: if owner(uid);
      }

      match /shopping_lists/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly([
            'name', 'archivedAt', 'createdAt', 'updatedAt', 'schemaVersion'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && (!('archivedAt' in request.resource.data)
              || request.resource.data.archivedAt is timestamp)
          && validAuditFields();
        allow delete: if owner(uid);
        match /items/{itemId} {
          allow read: if owner(uid);
          allow create, update: if owner(uid)
            && request.resource.data.keys().hasOnly([
              'listId', 'name', 'quantity', 'note', 'estimatedPriceMinor',
              'currency', 'isChecked', 'position', 'checkedAt', 'createdAt',
              'updatedAt', 'schemaVersion'
            ])
            && request.resource.data.listId == id
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 160
            && request.resource.data.quantity is string
            && request.resource.data.isChecked is bool
            && request.resource.data.position is int
            && request.resource.data.position >= 0
            && (!('estimatedPriceMinor' in request.resource.data)
                || (request.resource.data.estimatedPriceMinor is int
                    && request.resource.data.estimatedPriceMinor >= 0))
            && (!('currency' in request.resource.data)
                || (request.resource.data.currency is string
                    && request.resource.data.currency.size() == 3))
            && (!('checkedAt' in request.resource.data)
                || request.resource.data.checkedAt is timestamp)
            && validAuditFields();
          allow delete: if owner(uid);
        }
      }

      match /wishlist_items/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly([
            'originalUrl', 'canonicalUrl', 'siteHost', 'title', 'imageUrl',
            'image', 'priceMinor', 'currency', 'status', 'note',
            'metadataSource', 'metadataFetchedAt', 'createdAt', 'updatedAt',
            'schemaVersion'
          ])
          && request.resource.data.originalUrl is string
          && request.resource.data.originalUrl.matches('https://.*|http://.*')
          && request.resource.data.title is string
          && request.resource.data.siteHost is string
          && request.resource.data.status in ['wanted', 'purchased', 'archived']
          && (!('priceMinor' in request.resource.data)
              || (request.resource.data.priceMinor is int
                  && request.resource.data.priceMinor >= 0))
          && (!('currency' in request.resource.data)
              || (request.resource.data.currency is string
                  && request.resource.data.currency.size() == 3))
          && (!('canonicalUrl' in request.resource.data)
              || request.resource.data.canonicalUrl.matches('https://.*|http://.*'))
          && (!('imageUrl' in request.resource.data)
              || request.resource.data.imageUrl.matches('https://.*|http://.*'))
          && (!('metadataFetchedAt' in request.resource.data)
              || request.resource.data.metadataFetchedAt is timestamp)
          && validAuditFields();
        allow delete: if owner(uid);
      }

      match /books/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && (!('rating' in request.resource.data)
              || (request.resource.data.rating is int
                  && request.resource.data.rating >= 1
                  && request.resource.data.rating <= 5))
          && validAuditFields();
        allow delete: if owner(uid);
      }

      match /gratitude_entries/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.localDate is string
          && ((!('text' in request.resource.data)
              || request.resource.data.text.size() > 0)
              || ('images' in request.resource.data
                  && request.resource.data.images.size() > 0))
          && validAuditFields();
        allow delete: if owner(uid);
      }

      match /integrations/{document} {
        allow read, write: if owner(uid) && document == 'google_calendar';
      }

      match /exports/{exportId} {
        allow read, write: if owner(uid);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
